# === Instagram (Meta Developer App) ===
IG_APP_ID=
IG_APP_SECRET=
IG_USER_ID=
IG_INITIAL_TOKEN=
# "instagram_login" (default) or "facebook_login" (needed for Audio API)
IG_AUTH_MODE=instagram_login

# === Supabase ===
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# === Gemini ===
GEMINI_API_KEY=
# e.g. gemini-2.0-flash
GEMINI_MODEL=

# === Pexels ===
PEXELS_API_KEY=

# === Unsplash ===
UNSPLASH_ACCESS_KEY=

# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# === Publishing safety ===
ALLOW_LIVE_PUBLISH=false

# === Feature flags ===
FEATURE_IG_AUDIO=false
