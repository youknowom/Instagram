# === Instagram (Meta Developer App) ===
# Meta app credentials from App settings > Basic (used by Unified Login).
META_APP_ID=
META_APP_SECRET=
IG_CONFIG_ID=
# Direct Instagram Login credentials for older apps that still expose that setup.
IG_CLIENT_ID=
IG_CLIENT_SECRET=
IG_SESSION_SECRET=
# "facebook_login" for the Meta Unified Login configuration; "instagram_login" for older apps.
IG_AUTH_MODE=facebook_login
IG_GRAPH_API_VERSION=v26.0

# === Supabase ===
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# === Gemini ===
GEMINI_API_KEY=
# e.g. gemini-2.0-flash
GEMINI_MODEL=

# === Pexels ===
PEXELS_API_KEY=

# === Unsplash ===
UNSPLASH_ACCESS_KEY=

# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# === Publishing safety ===
ALLOW_LIVE_PUBLISH=false

# === Feature flags ===
FEATURE_IG_AUDIO=false
